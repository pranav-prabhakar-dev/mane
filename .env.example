# --- Database (Neon/Supabase/Vercel Postgres) ---
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# --- NextAuth / Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Only needed when not on Vercel (Vercel injects automatically)
# AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <YOUR_DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
